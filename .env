# ---------------------------------------------------------------------------
# Training credentials. Deliberately weak and committed to the repository so
# every student starts from an identical, working state.
# A real project keeps this file out of version control.
# ---------------------------------------------------------------------------

# InfluxDB
# NOTE: the official image rejects passwords shorter than 8 characters, so
# "admin" alone will not start. See docs/09-troubleshooting.md.
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=admin12345
INFLUXDB_ORG=training
INFLUXDB_BUCKET=sensors
INFLUXDB_TOKEN=training-token-do-not-use-in-production

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Node-RED timezone (affects timestamps in your flows)
TZ=Asia/Jakarta
